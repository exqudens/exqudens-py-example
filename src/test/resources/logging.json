{
    "version": 1,
    "formatters": {
        "formatter": {
            "format": "%(asctime)s %(levelname)-4.4s [%(threadName)s] %(name)s %(funcName)s(%(filename)s:%(lineno)d): %(message)s"
        }
    },
    "handlers": {
        "handler": {
            "class": "logging.StreamHandler",
            "stream": "ext://sys.stdout",
            "formatter": "formatter"
        }
    },
    "loggers": {
        "root": {
            "level": "DEBUG",
            "handlers": [
                "handler"
            ]
        }
    }
}
