{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "pytest-entry",
            "type": "pickString",
            "description": "Pytest Entry",
            "options": [
                "@_OPTIONS@"
            ],
            "default": "@_DEFAULT@"
        }
    ],
    "configurations": [
        {
            "name": "help",
            "type": "node",
            "request": "launch",
            "console": "internalConsole",
            "outputCapture": "std",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "python",
            "runtimeArgs": [
                "project.py",
                "help"
            ],
            "windows": {
                "runtimeExecutable": "py"
            }
        },
        {
            "name": "clean_env env",
            "type": "node",
            "request": "launch",
            "console": "internalConsole",
            "outputCapture": "std",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "python",
            "runtimeArgs": [
                "project.py",
                "clean_env",
                "env"
            ],
            "windows": {
                "runtimeExecutable": "py"
            }
        },
        {
            "name": "clean_package package",
            "type": "node",
            "request": "launch",
            "console": "internalConsole",
            "outputCapture": "std",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "python",
            "runtimeArgs": [
                "project.py",
                "clean_package",
                "package"
            ],
            "windows": {
                "runtimeExecutable": "py"
            }
        },
        {
            "name": "clean_test_env test_env",
            "type": "node",
            "request": "launch",
            "console": "internalConsole",
            "outputCapture": "std",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "python",
            "runtimeArgs": [
                "project.py",
                "clean_test_env",
                "test_env"
            ],
            "windows": {
                "runtimeExecutable": "py"
            }
        },
        {
            "name": "clean_test test",
            "type": "node",
            "request": "launch",
            "console": "internalConsole",
            "outputCapture": "std",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "python",
            "runtimeArgs": [
                "project.py",
                "clean_test",
                "test"
            ],
            "windows": {
                "runtimeExecutable": "py"
            }
        },
        {
            "name": "clean",
            "type": "node",
            "request": "launch",
            "console": "internalConsole",
            "outputCapture": "std",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "python",
            "runtimeArgs": [
                "project.py",
                "clean"
            ],
            "windows": {
                "runtimeExecutable": "py"
            }
        },
        {
            "name": "vscode",
            "type": "node",
            "request": "launch",
            "console": "internalConsole",
            "outputCapture": "std",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "python",
            "runtimeArgs": [
                "project.py",
                "vscode"
            ],
            "windows": {
                "runtimeExecutable": "py"
            }
        },
        {
            "name": "debugpy-pytest",
            "type": "debugpy",
            "request": "launch",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/build/test/env/bin/python",
            "module": "pytest",
            "args": [
                "${input:pytest-entry}"
            ],
            "windows": {
                "python": "${workspaceFolder}/build/test/env/Scrypts/python.exe"
            }
        }
    ]
}
